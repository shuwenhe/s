#!/bin/bash
# Hook to prevent pushing commits with Copilot Co-authored-by trailers
# This is a final safety net before pushing to remote

protected_branch='main'
current_branch=$(git rev-parse --abbrev-ref HEAD)

# Only check on protected branches
if [[ "$current_branch" != "$protected_branch" ]]; then
    exit 0
fi

echo "🔍 Checking for Copilot commits before pushing to $protected_branch..."

# Get list of commits to be pushed
commits=$(git rev-list origin/$protected_branch..$current_branch)

found_copilot=0
for commit in $commits; do
    # Only match trailer lines (starting with "Co-authored-by: Copilot"), not content
    if git show "$commit" --format="%B" | grep -E "^Co-authored-by:.*Copilot" > /dev/null; then
        echo "❌ Found Copilot Co-authored-by in commit: $commit"
        git show "$commit" --format="%H %s" | head -1
        found_copilot=1
    fi
done

if [ $found_copilot -eq 1 ]; then
    echo ""
    echo "❌ ERROR: Cannot push commits with Copilot Co-authored-by trailers!"
    echo "Policy: Only shuwenhe (1201220707@pku.edu.cn) should be credited in remote repository."
    echo ""
    echo "To fix:"
    echo "  1. Rebase and remove Copilot trailers from your commits"
    echo "  2. Or use: git filter-branch --msg-filter 'sed \"/^Co-authored-by: Copilot/d\"'"
    echo ""
    exit 1
fi

echo "✓ All commits are clean (no Copilot info)"
exit 0
