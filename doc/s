Variable definition
x := 10              // Mutable
const y = 5         // Immutable
int z  = 15          // Explicit type
int w = 20           // Explicit type, mutable

Assignment
x = x + 1                   // Expression assignment
arr[0] = 42                 // Array assignment
struct_val.field = 100      // Struct field assignment

