S Language Complete Syntax Guide

1. Basic Types
int                 // Integer
float               // Float
bool                // Boolean
char                // Character
void                // No return value
string              // String
Type*               // Pointer type
Type[]              // Array type
Type[size] varname
int[256] tokens    // 固定长度数组：256 个 int
int[] tokens       // 动态长度 slice

2. Struct Definition
Basic struct
struct struct_name {
    field_type field_name
    field_type field_name
    field_type field_name
}

Example
struct person {
    int age
    string name
    float height
}

struct config {
    int port
    string hostname
    bool debug
}

3. Function Definition
Basic function
func function_name(param_type param_name) return_type {
    // Function body
}

Example
func add(int a, int b) int {
    a + b
}

func greet(string name) string {
    "Hello, " + name
}

Key points
- Implicit return: last expression serves as return value (no need for `return` keyword)
- Parameter passing: default is pass-by-value

4. Multiple Return Values
func function_name(param_type param_name) (return_type1, return_type2) {
    return value1, value2
}

Example
func divide(int a, int b) (int, int) {
    return a / b, a % b
}

// Call
quotient, remainder := divide(10, 3)

5. Method Definition (Receiver Pattern)
Basic method
func (receiver_type receiver_name) method_name(parameter_type parameter_name) return_type {
    // receiver_name acts as this/self
}

Example
struct circle {
    int radius
}

func (circle c) area() int {
    c.radius * c.radius * 314 / 100
}

func (circle c) diameter() int {
    c.radius * 2
}

// Call
c := circle { radius: 5 }
a := c.area()
d := c.diameter()

Key points
- Receiver can be value or pointer
- Receiver name is used within the method

6. Pointers and Mutability
Value receiver (read-only)
func (circle c) area() int {
    // c is read-only, cannot be modified
}

Pointer receiver (mutable)
func (circle* c) scale(int factor) {
    c.radius = c.radius * factor // c is a mutable pointer, can be modified
}

Example
struct counter {
    int value
}

func (counter c) get_value() int {
    c.value
}

func (counter* c) increment() {
    c.value = c.value + 1
}

func (counter* c) add(int n) {
    c.value = c.value + n
}

// Call
count := counter { value: 0 }
count.increment()
count.add(5)
v := count.get_value()  // v = 6

7. Parameter Passing Pattern
Value parameter (copy)
func process(int value) int {
    value  // Modifying value does not affect original
}

Pointer parameter (reference, mutable)
func update(int* value) {
    value = value * 2  // Modification affects original
}

func modify(person* p) {
    p.age = p.age + 1  // Modify struct field
}

Example
func increment(int* num) {
    num = num + 1
}

func increment_person_age(person* p) {
    p.age = p.age + 1
}

// Call
x := 5
increment(&x)  // x is now 6

john := person { age: 30, name: "John" }
increment_person_age(&john)  // john.age is now 31

8. Array and Slice
Array definition
int[]               // Slice type (dynamic array)
int[3]              // Array type (fixed size)
string[]            // String slice
Type*[]             // Slice of pointers

Fixed array
a := int[3]{10, 20, 30}      // Fixed array, len=3, cap=3, immutable size

Dynamic slice (like Go)
v := int[]{10, 20, 30}       // Slice literal, len=3, cap≥3
empty := int[]               // Empty slice
s := make(int[], 10)         // Make slice with length 10
s := make(int[], 3, 10)      // Make slice, length 3, capacity 10

Array operations
len(arr)                        // Get array/slice length
cap(arr)                        // Get slice capacity
arr[0]                          // Access element (read)
arr[0] = 42                     // Modify element (write)
s[1:3]                          // Slice operation: elements from index 1 to 3
s[1:]                           // Slice from index 1 to end
s[:3]                           // Slice from start to index 3
append(s, 4)                    // Append element (returns new slice)
append(s, 5, 6, 7)              // Append multiple elements

Example: Sum array elements
func sum_array(int[] arr) int {
    sum := 0
    i := 0
    for i < len(arr) {
        sum = sum + arr[i]
        i = i + 1
    }
    sum
}

Example: Using slice with append
func append_numbers(int[] s) int[] {
    s = append(s, 10)
    s = append(s, 20)
    s = append(s, 30)
    s
}

Example: Slice iteration
func print_slice(int[] s) {
    for i in 0..len(s) {
        println(s[i])
    }
}

Key points on slices
- Slices are dynamic arrays (like Go slices)
- Slice header: array pointer + length + capacity
- append() may reallocate memory if needed
- Slices share underlying array (memory sharing)
- No vector library needed - slices are built-in

9. Control Flow
if/else
if condition {
    // Code block
} else {
    // Code block
}

if x > 0 {
    y = x + 1
} else if x == 0 {
    y = 0
} else {
    y = x - 1
}

for loop
for i in 0..10 {
    // i from 0 to 9
}

for item in array {
    // Iterate over array
}

switch expression
switch value {
    case1 : { block1 },
    case2 : { block2 },
    _ : { default_block }
}

switch color {
    "red" : { print_red() },
    "blue" : { print_blue() },
    _ : { print_unknown() }
}

